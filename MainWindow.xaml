<Window x:Class="JobApplicationManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JobApplicationManager.ViewModels"
        xmlns:views="clr-namespace:JobApplicationManager.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Työnhaku-CRM"
        Height="660" Width="1150" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Applications.SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Applications.NewApplicationCommand}" />
    </Window.InputBindings>

    <TabControl Margin="8">
        <TabItem Header="Hakemukset">
            <views:ApplicationsView DataContext="{Binding Applications}" />
        </TabItem>
        <TabItem Header="Yritykset">
            <TextBlock Margin="16" Foreground="Gray"
                       Text="Tulossa: yritysten ja toimialojen hallinta." />
        </TabItem>
        <TabItem Header="Tilastot">
            <TextBlock Margin="16" Foreground="Gray"
                       Text="Tulossa: yhteenveto hakemuksista, vastausprosentti ja eteneminen haastatteluihin." />
        </TabItem>
    </TabControl>
</Window>
