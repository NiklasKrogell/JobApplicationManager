<Window x:Class="JobApplicationManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:JobApplicationManager.ViewModels"
        xmlns:views="clr-namespace:JobApplicationManager.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Työnhaku-CRM"
        Height="660" Width="1150" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    </Window.InputBindings>

    <TabControl x:Name="MainTabs" Margin="8" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem x:Name="ApplicationsTab" Header="Hakemukset">
            <views:ApplicationsView DataContext="{Binding Applications}" />
        </TabItem>
        <TabItem x:Name="CompaniesTab" Header="Yritykset">
            <views:CompaniesView DataContext="{Binding Companies}" />
        </TabItem>
        <TabItem x:Name="StatisticsTab" Header="Tilastot">
            <views:StatisticsView DataContext="{Binding Statistics}" />
        </TabItem>
        <TabItem x:Name="SettingsTab" Header="Asetukset">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
