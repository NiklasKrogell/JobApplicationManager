<Application x:Class="JobApplicationManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JobApplicationManager.Converters">
    <!-- Ei StartupUri:a: pääikkuna luodaan App.xaml.cs:n OnStartupissa, jotta sille voidaan antaa ViewModel. -->
    <Application.Resources>
        <conv:EnumDescriptionConverter x:Key="EnumDescription" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Lomakkeiden kenttäotsikot -->
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,8,0,2" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2,3" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style x:Key="ViewTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
